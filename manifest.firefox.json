{
  "manifest_version": 3,
  "name": "Maziar",
  "version": "0.1.0",
  "description": "LaTeX editor and paper-submission tracker, right in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Open Maziar"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://codeload.github.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "maziar@farhadshad.com",
      "strict_min_version": "115.0"
    }
  }
}
